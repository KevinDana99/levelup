# Server-only secrets for local Supabase Edge Function development.
# Copy this file to supabase/functions/.env and provide the real value locally.
GROQ_API_KEY=your-groq-api-key

# Optional. handleAIService defaults to Qwen 3.8 27B through Groq.
GROQ_MODEL=qwen/qwen3.8-27b

# Kept for the separate handleGeminiAIService implementation.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Server-only key for USDA FoodData Central. DEMO_KEY is used when omitted,
# but its limits are only suitable for initial development.
USDA_API_KEY=your-data-gov-api-key

# Open Food Facts asks API clients to identify themselves with an app and contact.
OPEN_FOOD_FACTS_USER_AGENT=LevelUp/0.1.0 (your-contact@example.com)
