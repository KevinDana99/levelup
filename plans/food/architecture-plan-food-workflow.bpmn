<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_LevelUp" targetNamespace="https://levelup.local/bpmn" exporter="LevelUp Architecture" exporterVersion="1.0">
  <bpmn:process id="Process_LevelUp" name="LevelUp | Nutrición - responsabilidades" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Responsibilities">
      <bpmn:lane id="Lane_Board" name="Tablero · React Native / Expo">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>capture</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>choice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Background" name="Background · coordinación asíncrona">
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>response</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Functions" name="Supabase · Edge Functions HTTP">
        <bpmn:flowNodeRef>analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Services" name="Supabase · servicios internos">
        <bpmn:flowNodeRef>ai</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>food</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>usda</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>off</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>calc</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_External" name="APIs externas / Persistencia">
        <bpmn:flowNodeRef>gemini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>usda_api</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>off_api</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>db</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Inicio · foto de comida"/>
    <bpmn:userTask id="capture" name="Capturar foto + preferencias"/>
    <bpmn:task id="request" name="Solicitar análisis"/>
    <bpmn:serviceTask id="analyze" name="analyze-meal/index.ts" implementation="##unspecified"/>
    <bpmn:task id="ai" name="handleAIService.ts"/>
    <bpmn:task id="gemini" name="Gemini API · visión / tools"/>
    <bpmn:task id="food" name="handleFindByFood.ts"/>
    <bpmn:task id="usda" name="searchUSDA.ts"/>
    <bpmn:task id="usda_api" name="USDA FoodData Central"/>
    <bpmn:exclusiveGateway id="match" name="¿Coincidencia válida?"/>
    <bpmn:task id="off" name="searchOpenFoodFacts.ts"/>
    <bpmn:task id="off_api" name="Open Food Facts API"/>
    <bpmn:task id="calc" name="calculateNutrition.ts"/>
    <bpmn:task id="response" name="Resultado de analyze-meal"/>
    <bpmn:userTask id="review" name="Tablero · revisar / editar"/>
    <bpmn:exclusiveGateway id="choice" name="¿Confirmar?"/>
    <bpmn:serviceTask id="confirm" name="confirm-meal/index.ts" implementation="##unspecified"/>
    <bpmn:task id="db" name="Supabase PostgreSQL"/>
    <bpmn:endEvent id="done" name="Comida guardada"/>
    <bpmn:endEvent id="cancel" name="Cancelar registro"/>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="start" targetRef="capture"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="capture" targetRef="request"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="request" targetRef="analyze"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="analyze" targetRef="ai"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="ai" targetRef="gemini"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="gemini" targetRef="food" name="Function calling"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="food" targetRef="usda"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="usda" targetRef="usda_api"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="usda_api" targetRef="match"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="match" targetRef="calc" name="Sí"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="match" targetRef="off" name="No"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="off" targetRef="off_api"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="off_api" targetRef="calc"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="calc" targetRef="response"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="response" targetRef="review"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="review" targetRef="choice"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="choice" targetRef="confirm" name="Sí"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="choice" targetRef="cancel" name="No"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="confirm" targetRef="db"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="db" targetRef="done"/>
    <bpmn:textAnnotation id="DTO_analyze">
      <bpmn:text>AnalyzeMealRequestDTO → AnalyzeMealResponseDTO</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_DTO_analyze" sourceRef="analyze" targetRef="DTO_analyze"/>
    <bpmn:textAnnotation id="DTO_confirm">
      <bpmn:text>ConfirmMealRequestDTO → ConfirmMealResponseDTO</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_DTO_confirm" sourceRef="confirm" targetRef="DTO_confirm"/>
    <bpmn:textAnnotation id="DTO_ai">
      <bpmn:text>AIRequestDTO → AIResponseDTO; AIContracts.ts</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_DTO_ai" sourceRef="ai" targetRef="DTO_ai"/>
    <bpmn:textAnnotation id="DTO_food">
      <bpmn:text>FindByFoodInputDTO → FindByFoodOutputDTO (pendiente)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_DTO_food" sourceRef="food" targetRef="DTO_food"/>
    <bpmn:textAnnotation id="DTO_shared">
      <bpmn:text>_shared/dtos: FoodDTO, NutritionDTO, MealDTO
_shared/clients: supabase.client.ts</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_DTO_shared" sourceRef="calc" targetRef="DTO_shared"/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_LevelUp"><bpmn:participant id="Participant_LevelUp" name="LevelUp · Nutrición" processRef="Process_LevelUp"/></bpmn:collaboration><bpmndi:BPMNDiagram id="Diagram_LevelUp">
